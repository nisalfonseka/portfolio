# Admin access (required for /admin)
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Neon Postgres (neon link pulls both into .env)
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Neon Object Storage (neon deploy pulls these into .env)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Brevo transactional email (admin composer) and optional SMS inquiry alerts
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@nisalfonseka.com
BREVO_SENDER_NAME=Nisal Fonseka
BREVO_SMS_RECIPIENT=94770000000
BREVO_SMS_SENDER=NisalSite

# Public site URL used by metadata and sitemap
NEXT_PUBLIC_SITE_URL=https://nisalfonseka.com
