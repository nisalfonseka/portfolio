# Admin access (required for /admin)
ADMIN_PASSWORD="Nisal#2220"
AUTH_SECRET=replace-with-at-least-32-random-characterssseredddesss

# Neon Postgres (neon link pulls both into .env)
DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Neon Object Storage (neon deploy pulls these into .env)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Optional Brevo SMS alert for each new inquiry
BREVO_API_KEY=
BREVO_SMS_RECIPIENT=94770000000
BREVO_SMS_SENDER=NisalSite

# Public site URL used by metadata and sitemap
NEXT_PUBLIC_SITE_URL=https://nisalfonseka.com
